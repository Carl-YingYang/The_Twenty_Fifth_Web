# ─────────────────────────────────────────────────────────────
# The Twenty-Fifth — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
#
# IMPORTANT: Never commit the real `.env` file — it contains secrets.

# SQLite database path. The file is created automatically on first run
# after you push the Prisma schema (see README → Setup).
DATABASE_URL="file:./db/custom.db"

# Groq API key — used ONLY server-side by /api/chat for the guest
# concierge chatbot. Get a free key at https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"
