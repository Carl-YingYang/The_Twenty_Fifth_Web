# ─────────────────────────────────────────────────────────────
# The Twenty-Fifth — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
#
# IMPORTANT: Never commit the real `.env` file — it contains secrets.

# PostgreSQL database URL (Supabase).
# Use the TRANSACTION-MODE pooler (port 6543) for app queries — it
# supports many concurrent connections on serverless (Vercel).
# Get this from: Supabase Dashboard → Connect → URI → Transaction mode
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (SESSION-MODE pooler, port 5432) — used by Prisma
# for migrations / `db:push` only. Pgbouncer's transaction mode can't
# run DDL, so Prisma needs a direct connection for schema changes.
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# Groq API key — used ONLY server-side by /api/chat for the guest
# concierge chatbot. Get a free key at https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# ─────────────────────────────────────────────────────────────
# Auth & Security (P0 — REQUIRED)
# ─────────────────────────────────────────────────────────────

# NextAuth secret — signs the JWT session cookie. Generate with:
#   openssl rand -base64 32
# The app will REFUSE to boot if this is missing.
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Public URL of the deployed app. Used by NextAuth for cookie scope
# and for absolute links in email templates.
# Local dev:  http://localhost:3000
# Production: https://the25thinzambales.com
NEXTAUTH_URL="http://localhost:3000"

# Initial admin password used by `bun run db:seed`. MUST be at least
# 8 characters. Change this before running the seed in any shared or
# production environment — and rotate it after the first admin logs in
# and changes their password in Settings.
ADMIN_SEED_PASSWORD="change-me-to-a-real-password"

# ─────────────────────────────────────────────────────────────
# Rate Limiting (P1 — REQUIRED for production, optional in dev)
# ─────────────────────────────────────────────────────────────
# Upstash Redis REST credentials. If BOTH are unset, rate limiting is
# disabled (fail-open) — the app still runs, but login/booking/chat
# endpoints are unprotected against abuse. Get these from:
#   Upstash Console → Create Database → REST API section.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
